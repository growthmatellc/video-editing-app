# --- Database (any Postgres) ---
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# --- LLM: pick ONE path ---
# Direct Anthropic:
ANTHROPIC_API_KEY=""
# OR route through Vercel AI Gateway (leave ANTHROPIC_API_KEY blank if using this):
AI_GATEWAY_API_KEY=""
LLM_MODEL="claude-opus-4-8"

# --- File storage for generated decks ---
BLOB_READ_WRITE_TOKEN=""

# --- Auth (optional; set AUTH_ENABLED=false to run single-operator with no login) ---
AUTH_ENABLED="false"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- Branding (see theme/tokens.ts; these are fallbacks only) ---
NEXT_PUBLIC_APP_NAME="Webinar Studio"
