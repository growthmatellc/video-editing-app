# --- Database (any Postgres) ---
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# --- LLM: pick ONE path ---
# Direct Anthropic:
ANTHROPIC_API_KEY=""
# OR route through Vercel AI Gateway (leave ANTHROPIC_API_KEY blank if using this):
AI_GATEWAY_API_KEY=""
LLM_MODEL="claude-opus-4-8"

# --- File storage for generated decks and video previews ---
# Also required on Vercel for footage uploads larger than the ~4.5MB request cap.
# Local `npm run dev` can upload without this; files land in public/generated.
BLOB_READ_WRITE_TOKEN=""

# --- Video Edit ---
# ffmpeg is detected on PATH. ffmpeg-static is the fallback (used on Vercel).
# Set FFMPEG_PATH only to point at a specific binary.
FFMPEG_PATH=""
FFPROBE_PATH=""
# Transcription provider: auto (Deepgram, then AssemblyAI, then OpenAI), or one of those names.
# With no key, the stage still removes silences and asks you to paste a timestamped transcript.
TRANSCRIPTION_PROVIDER="auto"
DEEPGRAM_API_KEY=""
ASSEMBLYAI_API_KEY=""
OPENAI_API_KEY=""
OPENAI_TRANSCRIBE_MODEL="whisper-1"

# --- Auth (optional; set AUTH_ENABLED=false to run single-operator with no login) ---
AUTH_ENABLED="false"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# --- Branding (see theme/tokens.ts; these are fallbacks only) ---
NEXT_PUBLIC_APP_NAME="Webinar Studio"

# --- Sync knowledge button (pull growthmate-knowledge from GitHub) ---
# GitHub token with read access to the private knowledge repo
GITHUB_TOKEN=""
# Optional overrides (defaults shown)
KNOWLEDGE_REPO="growthmatellc/growthmate-knowledge"
KNOWLEDGE_BRANCH="main"

# --- Copywriting auditor (Python function at /api/audit) ---
# Local checkout of the KB, used by `npm run vendor:auditor` to vendor the auditor.
KNOWLEDGE_REPO_PATH=""
# Override the auditor endpoint. Defaults to this deployment's own /api/audit
# (VERCEL_URL in prod, localhost in dev), so you usually leave this blank.
COPY_AUDITOR_URL=""
